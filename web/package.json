{
  "name": "siralex-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:e2e:usage": "npm run build && playwright test -c playwright.config.ts",
    "test:e2e:usage:headed": "npm run build && playwright test -c playwright.config.ts --headed",
    "build:report": "REPORT=true npm run build"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.2.3",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.1.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-pwa": "^1.2.0",
    "vitest": "^4.0.18"
  },
  "dependencies": {
    "@noble/hashes": "1.8.0"
  }
}
